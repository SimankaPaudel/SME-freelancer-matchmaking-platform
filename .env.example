# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================
# NODE & DEPLOYMENT
# ============================================
NODE_ENV=production
PORT=5000

# ============================================
# DATABASE
# ============================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-in-production
MONGO_DB=freelance_db

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# ============================================
# ESEWA PAYMENT CONFIGURATION
# ============================================
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_VERIFY_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@freelanceplatform.com

# ============================================
# FRONTEND URLS
# ============================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# VITE FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_ENV=production
