# Environment Configuration Template
# Copy this file to .env and update with your actual values
# This template supports both LOCAL DEVELOPMENT and DOCKER COMPOSE setups

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# SERVER & PORTS
# ============================================
PORT=5000
FRONTEND_PORT=5173
MONGO_EXPRESS_PORT=8081

# ============================================
# DATABASE - LOCAL DEVELOPMENT
# ============================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
MONGO_DB=freelance_db
# Connection string for Docker Compose environment
MONGO_URI=mongodb://admin:password@mongodb:27017/freelance_db?authSource=admin

# ============================================
# DATABASE - TESTING
# ============================================
# Separate database for Jest/test environment
MONGO_TEST_URI=mongodb://localhost:27017/fyp_test
MONGO_TEST_DB=fyp_test

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Used in backend for redirects, emails, health checks
FRONTEND_URL=http://localhost:5173
FRONTEND_HOST=localhost
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Used in frontend for API calls
VITE_API_URL=http://localhost:5000/api
# WebSocket URL for real-time features
VITE_SOCKET_URL=http://localhost:5000
VITE_ENV=development

# ============================================
# SWAGGER API DOCUMENTATION
# ============================================
SWAGGER_API_URL=http://localhost:5000

# ============================================
# ESEWA PAYMENT GATEWAY (SANDBOX)
# ============================================
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_VERIFY_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status
# Frontend payment URLs for redirects after payment
VITE_ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yoursite.com
EMAIL_SECURE=false

# ============================================
# PRODUCTION DEPLOYMENT SETTINGS
# ============================================
# Uncomment and update these for production deployment
# NODE_ENV=production
# PORT=5000
# FRONTEND_URL=https://yourdomain.com
# CORS_ORIGIN=https://yourdomain.com,https://api.yourdomain.com
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
# SWAGGER_API_URL=https://api.yourdomain.com
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
# EMAIL_USER=production_email@gmail.com
# EMAIL_PASSWORD=production_app_password
# FRONTEND_HOST=yourdomain.com
