# backend/Dockerfile

# Use Node.js 18 LTS
FROM node:18

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the backend code
COPY . .

# Expose port (adjust if your server uses a different one)
EXPOSE 5000

# Start the server
CMD ["node", "server.js"]